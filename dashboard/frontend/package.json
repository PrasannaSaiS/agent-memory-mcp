{
  "name": "agent-memory-dashboard-frontend",
  "version": "0.1.0",
  "description": "Memory Console — observability dashboard for agent-memory-mcp. React + Vite frontend, talks only to the dashboard-bridge.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .tsx,.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "2.15.3"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@typescript-eslint/eslint-plugin": "8.35.0",
    "@typescript-eslint/parser": "8.35.0",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "10.4.21",
    "eslint": "9.29.0",
    "postcss": "^8.5.28",
    "prettier": "3.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vite": "^6.4.3"
  }
}
